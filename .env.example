# Etherscan API V2 — Arbitrum One evidence (see evidence/arbitrum-one/README.md)
# ETHERSCAN_API_KEY=

# Arc mainnet microgrant — LOCAL ONLY, never commit .env.local
# Bridge USDC to chain 5042 first (Circle CCTP). See docs/grants/ARC_MICROGRANT_SUBMIT.md
# ARC_MAINNET_PRIVATE_KEY=
# ARC_MAINNET_RECIPIENT=0x...   # wallet you control (recover 0.01 USDC proof)
# ARC_MAINNET_AMOUNT=10000       # 0.01 USDC @ 6 decimals
# ARC_CONFIRM=yes                # required for arc-mainnet-usdc-proof

PAYMENT_MODE=demo
X402_GUARD_ENABLED=false

# API — development defaults (override in production)
ALLOW_DEV_HEADER_AUTH=true
EXECUTION_KILL_SWITCH=false
MAX_EXECUTIONS_PER_ORG_HOUR=10
# DEMO_ORG_ALLOWLIST=org_demo_rollout

# Web — development defaults
NEXT_PUBLIC_ALLOW_DEV_AUTH=true
NEXT_PUBLIC_DEFAULT_ORG_ID=org_demo_rollout

# Production hosted demo (set on Encore + Vercel):
# ALLOW_DEV_HEADER_AUTH=false
# NEXT_PUBLIC_ALLOW_DEV_AUTH=false
# PAYMENT_MODE=demo
# DEMO_ORG_ALLOWLIST=org_demo_rollout
# WORKOS_CLIENT_ID=...
# WORKOS_API_KEY=...
